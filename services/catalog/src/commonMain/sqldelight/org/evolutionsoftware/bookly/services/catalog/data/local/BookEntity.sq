-- Local cache of the catalog. Everything here is re-downloadable, so the schema
-- carries no migrations: a schema change ships under a new database filename and
-- the cache simply rebuilds on first launch.

CREATE TABLE BookEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    category TEXT NOT NULL,
    categoryIds TEXT NOT NULL,
    emoji TEXT NOT NULL,
    imageUrl TEXT,
    -- Content revision reported by the list endpoint. Compared against the value
    -- stored on BookDetailEntity to decide whether cached pages are stale.
    revision TEXT,
    updatedAt INTEGER NOT NULL
);

CREATE TABLE BookDetailEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    category TEXT NOT NULL,
    cardsJson TEXT NOT NULL,
    -- Revision these pages were downloaded at.
    revision TEXT,
    updatedAt INTEGER NOT NULL
);

selectAllBooks:
SELECT * FROM BookEntity ORDER BY title;

selectBookById:
SELECT * FROM BookEntity WHERE id = ?;

selectBookRevision:
SELECT revision FROM BookEntity WHERE id = ?;

insertBook:
INSERT OR REPLACE INTO BookEntity(id, title, description, category, categoryIds, emoji, imageUrl, revision, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllBooks:
DELETE FROM BookEntity;

countBooks:
SELECT COUNT(*) FROM BookEntity;

selectBookDetailById:
SELECT * FROM BookDetailEntity WHERE id = ?;

insertBookDetail:
INSERT OR REPLACE INTO BookDetailEntity(id, title, category, cardsJson, revision, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

deleteBookDetailById:
DELETE FROM BookDetailEntity WHERE id = ?;

deleteOrphanedBookDetails:
DELETE FROM BookDetailEntity WHERE id NOT IN (SELECT id FROM BookEntity);
